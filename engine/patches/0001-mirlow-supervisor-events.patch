 #define LOGW(...) log(LOGGER_WARNING, __VA_ARGS__)
 #define LOGE(...) log(LOGGER_ERR, __VA_ARGS__)
 
+/* Mirlow: when run by a supervising application (MIRLOW_SUPERVISED is set in the
+ * environment), report state changes as single machine-readable stdout lines
+ * "@@mirlow <event> <args>", so the supervisor does not have to guess from log text. */
+static bool mirlow_supervised = false;
+
+static void mirlow_event(const char* format, ...) {
+    if (!mirlow_supervised) return;
+    char line[512];
+    int prefix = snprintf(line, sizeof(line), "@@mirlow ");
+    va_list vargs;
+    va_start(vargs, format);
+    vsnprintf(line + prefix, sizeof(line) - prefix - 1, format, vargs);
+    va_end(vargs);
+    strcat(line, "\n");
+    fputs(line, stdout);   /* one write per event, so lines from different threads do not interleave */
+    fflush(stdout);
+}
+
+/* Mirlow: whether sound from the client can be heard, judged by the audio renderer's level meter.
+ * "sound 1" is reported at once; "sound 0" only after a few seconds of silence, so that the gap
+ * between two songs is not reported. Both functions run on the main loop's thread. */
+#define MIRLOW_AUDIBLE_DB (-60.0)
+#define MIRLOW_SILENCE_US (3 * G_TIME_SPAN_SECOND)
+static bool mirlow_sound = false;
+static gint64 mirlow_sound_heard = 0;
+
+static void mirlow_sound_level(double peak_db) {
+    if (peak_db <= MIRLOW_AUDIBLE_DB) return;
+    mirlow_sound_heard = g_get_monotonic_time();
+    if (!mirlow_sound) {
+        mirlow_sound = true;
+        mirlow_event("sound 1");
+    }
+}
+
+static gboolean mirlow_sound_watch(gpointer data) {
+    bool silent = g_get_monotonic_time() - mirlow_sound_heard > MIRLOW_SILENCE_US;
+    if (mirlow_sound && (silent || open_connections == 0)) {
+        mirlow_sound = false;
+        mirlow_event("sound 0");
+    }
+    return G_SOURCE_CONTINUE;
+}
+
