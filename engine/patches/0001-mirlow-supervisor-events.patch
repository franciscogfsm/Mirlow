@@ -295,6 +295,24 @@ static void log(int level, const char* format, ...) {
 #define LOGW(...) log(LOGGER_WARNING, __VA_ARGS__)
 #define LOGE(...) log(LOGGER_ERR, __VA_ARGS__)
 
+/* Mirlow: when run by a supervising application (MIRLOW_SUPERVISED is set in the
+ * environment), report state changes as single machine-readable stdout lines
+ * "@@mirlow <event> <args>", so the supervisor does not have to guess from log text. */
+static bool mirlow_supervised = false;
+
+static void mirlow_event(const char* format, ...) {
+    if (!mirlow_supervised) return;
+    char line[512];
+    int prefix = snprintf(line, sizeof(line), "@@mirlow ");
+    va_list vargs;
+    va_start(vargs, format);
+    vsnprintf(line + prefix, sizeof(line) - prefix - 1, format, vargs);
+    va_end(vargs);
+    strcat(line, "\n");
+    fputs(line, stdout);   /* one write per event, so lines from different threads do not interleave */
+    fflush(stdout);
+}
+
 #ifdef DBUS
 static void dbus_screensaver_inhibiter(bool inhibit) {
     g_assert(inhibit != dbus_last_message);
@@ -625,6 +643,22 @@ static gboolean handle_signal(gpointer data) {
     return G_SOURCE_REMOVE;
 }
 
+/* Mirlow: the supervisor holds the write end of our stdin. When it closes that pipe
+ * (or exits for any reason) stdin reaches EOF and UxPlay shuts down cleanly, which
+ * also withdraws the mDNS advertisement instead of leaving a stale receiver name. */
+static gpointer mirlow_stdin_watch(gpointer data) {
+    char buf[64];
+    while (fgets(buf, sizeof(buf), stdin)) {
+        if (strncmp(buf, "quit", 4) == 0) break;
+    }
+    if (gmainloop) {
+        g_idle_add(handle_signal, NULL);
+    } else {
+        exit(0);
+    }
+    return NULL;
+}
