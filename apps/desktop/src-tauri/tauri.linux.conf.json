{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb"],
    "shortDescription": "Mirror your iPhone to Linux. For free.",
    "longDescription": "Mirlow turns your Linux PC into a wireless screen for your iPhone or iPad, using the Screen Mirroring built into the device.",
    "linux": {
      "deb": {
        "depends": [
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-gl",
          "libplist-2.0-4",
          "libssl3",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
